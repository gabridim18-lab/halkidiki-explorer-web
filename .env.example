# Server-only OpenAI credential. Set this in Vercel and in .env.local for local development.
OPENAI_API_KEY=

# Optional: defaults to gpt-4.1-mini when omitted.
OPENAI_MODEL=gpt-4.1-mini

# Used only if an administrator explicitly selects AI enhanced visual.
OPENAI_IMAGE_MODEL=gpt-image-2
SOCIAL_IMAGE_QUALITY=medium

# Supabase project settings used only by the serverless function to validate
# the browser session. SUPABASE_URL must be the project origin, for example
# https://your-project.supabase.co — do not use the /rest/v1 endpoint. The
# publishable key is not an OpenAI secret, but keeping it here avoids
# hard-coding server configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated Supabase Auth user UUIDs allowed to use the Studio.
# Leave blank to deny every user (secure by default).
SOCIAL_STUDIO_ADMIN_USER_IDS=

# Meta Social Publishing setup. These values are server-only: never put them
# in browser JavaScript, HTML, CSS, or localStorage. The redirect URI must be
# added verbatim to the Meta app's Valid OAuth Redirect URIs list.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/social/meta/callback

# Set this to a currently supported Meta Graph API version for the app.
META_GRAPH_API_VERSION=

# Use separate strong random secrets. META_SESSION_ENCRYPTION_KEY must be a
# base64-encoded 32-byte key, for example generated server-side with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_OAUTH_STATE_SECRET=
META_SESSION_ENCRYPTION_KEY=
